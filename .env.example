# =============================================================================
# Bozzi Website — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your real values:
#
#   cp .env.example .env
#
# Never commit `.env` to git — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required for /api/appointments)
# -----------------------------------------------------------------------------
# MongoDB connection string from MongoDB Atlas or a local instance.
# Example (Atlas): mongodb+srv://USER:PASSWORD@cluster.mongodb.net/bozzi?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/bozzi?retryWrites=true&w=majority"

# -----------------------------------------------------------------------------
# Email (required for /api/contact)
# -----------------------------------------------------------------------------
# SMTP server settings — use your mail provider (Gmail, SendGrid, etc.)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-app-password-or-smtp-token"

# Address that receives contact form submissions
CONTACT_ADDRESS="info@example.com"

# -----------------------------------------------------------------------------
# Google Calendar (optional — integration is prepared but disabled in code)
# -----------------------------------------------------------------------------
# Uncomment and fill these in if you enable Google Calendar sync in
# src/app/api/appointments/route.ts (requires googleapis package).
#
# GOOGLE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID="your-calendar-id@group.calendar.google.com"
